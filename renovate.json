{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "flux": {
    "managerFilePatterns": [
      "/clusters/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^clusters/.+\\.ya?ml$/"
    ],
    "ignorePaths": [
      "clusters/cobbler/flux-system/**"
    ]
  }
}
